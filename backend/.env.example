# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit file .env ke git.

# Ambil API key dari https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Ganti dengan string acak yang panjang (mis. hasil dari: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=change_this_to_a_random_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DATABASE_URL=sqlite:///./app.db

# Lokasi ChromaDB (akan dipakai mulai Fase 2)
CHROMA_PERSIST_DIR=./chroma_data
